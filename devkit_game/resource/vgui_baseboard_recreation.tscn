[sub_resource type="GDScript" id="GDScript_nxppy"]
resource_name = "baseboard_element_script"
script/source = "@tool
extends Control

@export var baseboard_color = Color(1,1,1,1)

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	$\"800corner1\".self_modulate = baseboard_color
	$\"800corner2\".self_modulate = baseboard_color
	$\"800corner3\".self_modulate = baseboard_color
	$\"800corner4\".self_modulate = baseboard_color
	$ColorRect.color = baseboard_color
	$ColorRect2.color = baseboard_color
	$ColorRect3.color = baseboard_color
	$ColorRect4.color = baseboard_color
	$ColorRect5.color = baseboard_color
	pass
"

